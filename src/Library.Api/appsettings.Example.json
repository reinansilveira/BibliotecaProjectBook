{
  "ConnectionStrings": {
    "Database": "Server=<server>,1433;Database=Library;User Id=<user>;Password=<password>;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "LibraryApi",
    "Audience": "LibraryApi.Clients",
    "Key": "<DO NOT STORE HERE: use the Jwt__Key environment variable (at least 32 characters)>",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Seed": {
    "Admin": {
      "Email": "<initial-admin-email>",
      "Password": "<DO NOT STORE HERE: use the Seed__Admin__Password environment variable>"
    },
    "DemoCatalog": true,
    "DemoEbooks": true
  },
  "MaintenanceJob": {
    "Enabled": true,
    "Cron": "0 0/15 * * * ?"
  },
  "Fines": {
    "DailyRate": 0.50,
    "Currency": "USD"
  },
  "Account": {
    "FrontEndUrl": "<front-end-url, e.g. https://your-user.github.io/library-web>"
  },
  "Caching": {
    "Enabled": true,
    "CatalogSeconds": 120
  },
  "Search": {
    "UseFullText": true
  },
  "Messaging": {
    "Enabled": true,
    "OutboxPollingIntervalSeconds": 5,
    "OutboxBatchSize": 20,
    "MaxPublishAttempts": 5
  },
  "RabbitMq": {
    "HostName": "<rabbitmq-host>",
    "Port": 5672,
    "UserName": "<user>",
    "Password": "<DO NOT STORE HERE: use the RabbitMq__Password environment variable>",
    "VirtualHost": "/"
  },
  "SendGrid": {
    "ApiKey": "<DO NOT STORE HERE: use User Secrets or the SendGrid__ApiKey environment variable>",
    "FromEmail": "<sendgrid-verified-sender>",
    "FromName": "Library"
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 10,
    "AuthenticationWindowSeconds": 60,
    "TrustForwardedHeaders": false
  },
  "Cors": {
    "AllowedOrigins": [
      "<front-end-origin, e.g. https://your-user.github.io>"
    ]
  },
  "Swagger": {
    "Enabled": false
  }
}
