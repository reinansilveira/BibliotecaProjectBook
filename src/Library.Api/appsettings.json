{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "LibraryApi",
    "Audience": "LibraryApi.Clients",
    "Key": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Seed": {
    "Admin": {
      "Email": "",
      "Password": ""
    }
  },
  "BlacklistJob": {
    "Enabled": true,
    "Cron": "0 0 * * * ?"
  },
  "Messaging": {
    "Enabled": true,
    "OutboxPollingIntervalSeconds": 5,
    "OutboxBatchSize": 20,
    "MaxPublishAttempts": 5
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/"
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "",
    "FromName": "Library"
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 10,
    "AuthenticationWindowSeconds": 60,
    "TrustForwardedHeaders": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  }
}
