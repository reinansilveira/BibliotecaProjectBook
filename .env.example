# Copy this file to .env and adjust the values. The .env file is not committed.
# These defaults are for local development only. Change all of them in any real environment.

SQLSERVER_SA_PASSWORD=Library@Dev123

# JWT signing key (at least 32 characters). Generate one with: openssl rand -base64 48
JWT_KEY=local-development-key-do-not-use-in-production-0123456789

# Administrator created automatically on the first startup.
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=Admin@123

# Sign-in, sign-up and refresh attempts allowed per client IP per minute. Raise it for load tests.
AUTH_RATE_LIMIT=10

RABBITMQ_USER=library
RABBITMQ_PASSWORD=library-dev

# Optional: without a key the API still works and only logs that the email was not sent.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
